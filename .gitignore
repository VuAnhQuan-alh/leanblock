# Whitelist: mặc định bỏ hết, chỉ mở đúng ly_thuyet + mo_rong ở mỗi môn
/*
!/.gitignore
!/simplychain/
!/houedu/
!/bokedu/
!/youtdu/

/simplychain/*
!/simplychain/ly_thuyet/
!/simplychain/mo_rong/

# houedu có thêm một tầng (mỗi môn một thư mục) nên phải mở tầng đó trước
/houedu/*
!/houedu/*/
/houedu/*/*
!/houedu/*/ly_thuyet/
!/houedu/*/mo_rong/
!/houedu/*/README.md 

# Ảnh hình/bảng cắt từ PDF giáo trình. Mở RIÊNG tai_lieu/hinh/ — phải mở tầng
# tai_lieu/ trước, rồi chặn lại nội dung của nó, rồi mới mở hinh/. Nhờ vậy PDF
# gốc (60 MB mỗi cuốn) vẫn nằm ngoài git.
!/houedu/*/tai_lieu/
/houedu/*/tai_lieu/*
!/houedu/*/tai_lieu/hinh/

# bokedu: cùng luật với houedu
/bokedu/*
!/bokedu/*/
/bokedu/*/*
!/bokedu/*/ly_thuyet/
!/bokedu/*/mo_rong/
!/bokedu/*/README.md
!/bokedu/*/tai_lieu/
/bokedu/*/tai_lieu/*
!/bokedu/*/tai_lieu/hinh/

/youtdu/*
!/youtdu/*/
/youtdu/*/*
!/youtdu/*/hinh/
!/youtdu/*/ly_thuyet/
!/youtdu/*/mo_rong/
!/youtdu/*/README.md 

.DS_Store
